<package format="3">
  <name>mapviz_plugins</name>
  <version>4.1.0</version>
  <description>
    Common plugins for the Mapviz visualization tool
  </description>
  <author>Marc Alban</author>
  <author>P. J. Reed</author>
  <maintainer email="swri-robotics@swri.org">Southwest Research Institute</maintainer>
  <license>BSD</license>
  <url>https://github.com/swri-robotics/mapviz</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>ament_index_cpp</build_depend>
  <build_depend>assimp</build_depend>
  <build_depend>cv_bridge</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>gps_msgs</build_depend>
  <build_depend>image_transport</build_depend>
  <build_depend>libopencv-dev</build_depend>
  <build_depend>map_msgs</build_depend>
  <build_depend>mapviz</build_depend>
  <build_depend>marti_common_msgs</build_depend>
  <build_depend>marti_nav_msgs</build_depend>
  <build_depend>marti_sensor_msgs</build_depend>
  <build_depend>marti_visualization_msgs</build_depend>
  <build_depend>nav2_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>qt-base-dev</build_depend>
  <build_depend>rclcpp</build_depend>
  <build_depend>rclcpp_action</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>stereo_msgs</build_depend>
  <build_depend>swri_image_util</build_depend>
  <build_depend>swri_math_util</build_depend>
  <build_depend>swri_route_util</build_depend>
  <build_depend>swri_transform_util</build_depend>
  <build_depend>tf2</build_depend>
  <build_depend>tf2_geometry_msgs</build_depend>
  <build_depend>urdf</build_depend>
  <build_depend>visualization_msgs</build_depend>

  <!-- Named by the installed plugin headers, so downstream packages compile
       against them too. -->
  <build_export_depend>cv_bridge</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>gps_msgs</build_export_depend>
  <build_export_depend>image_transport</build_export_depend>
  <build_export_depend>libopencv-dev</build_export_depend>
  <build_export_depend>map_msgs</build_export_depend>
  <build_export_depend>mapviz</build_export_depend>
  <build_export_depend>marti_common_msgs</build_export_depend>
  <build_export_depend>marti_nav_msgs</build_export_depend>
  <build_export_depend>marti_sensor_msgs</build_export_depend>
  <build_export_depend>marti_visualization_msgs</build_export_depend>
  <build_export_depend>nav2_msgs</build_export_depend>
  <build_export_depend>nav_msgs</build_export_depend>
  <build_export_depend>qt-base-dev</build_export_depend>
  <build_export_depend>rclcpp</build_export_depend>
  <build_export_depend>rclcpp_action</build_export_depend>
  <build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>stereo_msgs</build_export_depend>
  <build_export_depend>swri_route_util</build_export_depend>
  <build_export_depend>swri_transform_util</build_export_depend>
  <build_export_depend>tf2</build_export_depend>
  <build_export_depend>visualization_msgs</build_export_depend>

  <exec_depend>ament_index_cpp</exec_depend>
  <exec_depend>assimp</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>gps_msgs</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>libopencv-dev</exec_depend>
  <exec_depend>libqtcore</exec_depend>
  <exec_depend>libqtgui</exec_depend>
  <exec_depend>libqtopengl</exec_depend>
  <exec_depend>map_msgs</exec_depend>
  <exec_depend>mapviz</exec_depend>
  <exec_depend>marti_common_msgs</exec_depend>
  <exec_depend>marti_nav_msgs</exec_depend>
  <exec_depend>marti_sensor_msgs</exec_depend>
  <exec_depend>marti_visualization_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclcpp_action</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>stereo_msgs</exec_depend>
  <exec_depend>swri_image_util</exec_depend>
  <exec_depend>swri_math_util</exec_depend>
  <exec_depend>swri_route_util</exec_depend>
  <exec_depend>swri_transform_util</exec_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <mapviz plugin="${prefix}/mapviz_plugins.xml" />
  </export>

</package>


